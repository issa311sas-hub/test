# 環境変数のサンプル
# 使い方:
#   1. このファイルを .env にコピー
#   2. 実際のAPIキーを埋める
#   3. .env は .gitignore されているのでコミットされない
#
# シェルでの読み込み例（bash/zsh）:
#   export $(grep -v '^#' .env | xargs)
#
# Python での読み込み例（python-dotenv 使用）:
#   from dotenv import load_dotenv
#   load_dotenv()

# OpenAI (GPT-5 など)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude Sonnet 4.6 など)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google (Gemini 2.5 など)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 予算上限（円単位、超えたら警告する想定）
API_BUDGET_JPY=3000

# 実験ログの出力先（デフォルトは results/）
PILOT_OUTPUT_DIR=results

# モデル固定指定（バージョン固定が可能な場合）
# OPENAI_MODEL=gpt-5-2026-01-15
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250929
# GOOGLE_MODEL=gemini-2.5-pro-preview-2026-01
